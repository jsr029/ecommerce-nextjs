# =============================================================================
# LUNA — Environment variables
#
# Vercel tip:
# - Names starting with NEXT_PUBLIC_ are embedded in the browser bundle.
# - Everything else is server-only (keep as Sensitive / Secret on Vercel).
# - If Vercel says "Remove the public framework prefix": the value is private
#   → do NOT use NEXT_PUBLIC_. If the value is meant for the browser → mark as
#   "Config" (not Secret) OR keep NEXT_PUBLIC_ only for safe public values.
# =============================================================================

# --- SERVER ONLY (Secret / Sensitive on Vercel) ---
MONGODB_URI=mongodb://127.0.0.1:27017/luna
JWT_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=

# --- PUBLIC (browser — NEXT_PUBLIC_ is intentional) ---
# PayPal Client ID is designed to be public (used by PayPal JS SDK in the browser).
# On Vercel: set as "Config" (Environment Variable), not "Secret", OR accept
# that NEXT_PUBLIC_ exposes it — that is normal and safe for Client IDs.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb
