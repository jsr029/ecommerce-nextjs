# =============================================================================
# LUNA — Environment variables
# =============================================================================

# MongoDB — Atlas (Vercel) or Docker service name
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxx.mongodb.net/luna?retryWrites=true&w=majority
# Docker: mongodb://mongo:27017/luna
# Local:  mongodb://127.0.0.1:27017/luna
MONGODB_URI=mongodb://127.0.0.1:27017/luna

JWT_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb

# --- Google OAuth ---
# 1. https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth client ID (Application type: Web application)
# 3. Authorized redirect URIs:
#    http://localhost:3000/api/auth/google/callback
#    https://YOUR-DOMAIN/api/auth/google/callback
#    http://localhost:3000/api/auth/google/callback  (Docker)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (optional)
BLOB_READ_WRITE_TOKEN=
